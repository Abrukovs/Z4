# === Резервное копирование в GitHub (репозиторий публичный!) ===
# База данных SQLite содержит секреты (токен Telegram-бота) — НЕ пушим в GitHub.
# Для восстановления на новом сервере: bun run db:push + авто-сидинг данными.
/db/*.db
/db/*.db-journal

# Состояние telegram-бота (содержит токен бота)
/mini-services/*/data

# Локальные артефакты агентов (скриншоты QA, рабочие заметки)
/download
/agent-ctx
/--full-page
/screenshots

# PID-файл запущенных процессов
.zscripts/dev.pid

# Внутренние журналы агентов и выводы команд (могут содержать секреты)
/tool-results

# NOTE: worklog.md СОЗНАТЕЛЬНО отслеживается в git (убран из ignore):
# ночные сбросы окружения удаляют gitignored-файлы, а журнал работ —
# единственная память проекта. Секреты в него не записывать!
/backups
.zscripts/.git-push-stamp
